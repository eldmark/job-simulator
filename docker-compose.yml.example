version: "3.9"

services:
  db:
    image: postgres:15
    container_name: onepiece_db
    restart: always
    environment:
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: ${DB_NAME}
    ports:
      - "5432:5432"
    volumes:
      - ./backend/db/init.sql:/docker-entrypoint-initdb.d/init.sql

  api:
    build:
      context: ./backend
    container_name: onepiece_api
    restart: always
    depends_on:
      - db
    environment:
      DB_HOST: db
      DB_PORT: 5432
      DB_USER: ${DB_USER}
      DB_PASSWORD: ${DB_PASSWORD}
      DB_NAME: ${DB_NAME}
      PORT: ${PORT}
    ports:
      - "8080:8080"
    volumes:
      - ./backend:/app
    command: sh -c "npm install && node db/seed.js && npm start"

  frontend:
    build:
      context: ./frontend
    container_name: onepiece_frontend
    ports:
      - "3000:80"
    depends_on:
      - api